# PostgreSQL
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=waste
POSTGRES_PASSWORD=waste_dev_password
POSTGRES_DB=waste_monitoring

# S3-compatible storage (MinIO local / Yandex Object Storage prod)
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_dev_password
S3_SNAPSHOTS_BUCKET=snapshots
S3_REGION=ru-central1

# Backend
DEBUG=true
LOG_LEVEL=info
