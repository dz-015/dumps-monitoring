# Copy to `.env` and fill in real values before running `docker compose up`.

# Required. Generate with: openssl rand -hex 32
SECRET_KEY=

# Optional overrides. Defaults are baked into docker-compose.yml.

# Where the SQLite file lives inside the backend container. Volume-mounted
# at backend_db, so it survives `docker compose down`.
# DATABASE_URL=sqlite:////app/data/nekobak.db

# Origins allowed by the FastAPI CORS middleware. Either comma-separated
# or a JSON list — both work. In production set this to the public URL of
# the frontend, e.g.
# CORS_ORIGINS=https://nekobak.example.com
# CORS_ORIGINS=["http://localhost"]

# Token lifetime — 24 hours by default.
# ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Avatar upload size cap (bytes). 5 MiB by default.
# MAX_UPLOAD_BYTES=5242880

# Seed the demo organisation + admin/demo users on first start. OFF by
# default — set to 1 explicitly for a demo stand. Seeded passwords come from
# the vars below; when unset, random ones are generated and printed to the
# backend logs on first boot.
# RUN_SEED=0
# SEED_ADMIN_PASSWORD=
# SEED_DEMO_PASSWORD=

# Host port to expose the frontend on. Default 80.
# FRONTEND_PORT=80
